# ==========================================
# RSMTS BACKEND ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and replace the values with your actual configuration.

# ------------------------------------------
# 1. Server Configuration
# ------------------------------------------
# The port the NestJS server will listen on.
PORT=3001
# The environment mode: 'development', 'production', or 'test'
NODE_ENV=development

# ------------------------------------------
# 2. Database Configuration (PostgreSQL via Prisma)
# ------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Example for local development:
DATABASE_URL="postgresql://postgres:password@localhost:5432/rsmts_db?schema=public"
# Example for Railway production:
# DATABASE_URL="postgresql://postgres:random-password@containers-us-west-42.railway.app:5432/railway"

# ------------------------------------------
# 3. Authentication (JWT)
# ------------------------------------------
# A strong, randomly generated string used to sign JWT tokens.
# You can generate one using: openssl rand -base64 32
JWT_SECRET="super-secret-jwt-key-change-me-in-production"
# The expiration time for the access token (e.g., '15m', '1h', '1d')
JWT_EXPIRATION="1d"
# The expiration time for the refresh token (e.g., '7d')
JWT_REFRESH_EXPIRATION="7d"

# ------------------------------------------
# 4. Redis Cache Configuration
# ------------------------------------------
# Used for the high-performance Dashboard API and WebSocket adapters.
# Format: redis://[:password@]host[:port][/db-number]
# Example for local development:
REDIS_URL="redis://localhost:6379"
# Example for Railway production:
# REDIS_URL="redis://default:random-password@containers-us-west-42.railway.app:6379"

# ------------------------------------------
# 5. File Upload / Object Storage (Optional/Future)
# ------------------------------------------
# If using AWS S3 for photo uploads (Phase 4), configure here:
# AWS_REGION="ap-south-1"
# AWS_ACCESS_KEY_ID="your_access_key"
# AWS_SECRET_ACCESS_KEY="your_secret_key"
# AWS_S3_BUCKET="rsmts-assets-bucket"
